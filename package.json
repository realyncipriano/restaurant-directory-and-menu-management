{
  "name": "restaurant_directory_and_menu_management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.unit.config.mts",
    "test:watch": "vitest --config vitest.unit.config.mts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:integration": "tsx scripts/verify-test-db.ts && vitest run --config vitest.config.mts --reporter=verbose tests/integration",
    "smoke:public": "tsx scripts/smoke-public.ts",
    "db:generate": "drizzle-kit generate",
    "db:preflight": "tsx scripts/db-preflight.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:test": "tsx scripts/verify-test-db.ts && tsx scripts/db-migrate.ts --test",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:recover:admin": "tsx scripts/recover-admin.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:backup:check": "tsx scripts/db-backup-check.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:restore:drill": "tsx scripts/db-restore-drill.ts",
    "db:studio": "drizzle-kit studio",
    "check": "npm run lint && npm run typecheck && npm test",
    "verify": "npm run check && npm run test:db && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@neondatabase/serverless": "^1.2.1",
    "@node-rs/argon2": "^2.2.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.3.0",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.1.1"
  }
}
