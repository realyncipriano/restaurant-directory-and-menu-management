# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public base URL of the application (no trailing slash).
APP_URL="http://localhost:3000"

# Neon PostgreSQL pooled connection string used by the application.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon direct (non-pooled) connection string used for migrations and scripts.
DATABASE_URL_DIRECT="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# 32+ byte secret used to pepper session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# ---------------------------------------------------------------------------
# Cloudflare R2 (optional until you are ready to enable uploads)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public base URL for the bucket (custom domain or r2.dev URL), no trailing slash.
R2_PUBLIC_BASE_URL=""
# Optional endpoint override; defaults to https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=""

# ---------------------------------------------------------------------------
# Menu extraction (optional until you are ready to enable scanning)
# Supported provider: "openai" | "disabled"
# ---------------------------------------------------------------------------
EXTRACTION_PROVIDER="disabled"
EXTRACTION_BASE_URL="https://api.openai.com/v1"
EXTRACTION_API_KEY=""
EXTRACTION_MODEL="gpt-4o-mini"
# Maximum pages sent to the provider in one import request.
EXTRACTION_MAX_PAGES="10"
# Per-request timeout in milliseconds.
EXTRACTION_TIMEOUT_MS="90000"

# ---------------------------------------------------------------------------
# Administrative seed (only read by scripts/seed-admin.ts)
# Never commit real credentials. The seed script refuses to run without both.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Integration tests (dedicated disposable database ONLY)
# Never point these at your development database.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=""
ALLOW_DESTRUCTIVE_DB_TESTS=""
