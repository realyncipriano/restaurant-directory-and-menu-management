# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public base URL of the application (no trailing slash).
APP_URL="http://localhost:3000"

# Recovery CLI only. Set to 1 together with NODE_ENV=development to allow a
# local or HTTP APP_URL for `npm run db:recover:admin`. Always leave empty in
# production; the production-safe URL policy is the default.
RECOVER_ADMIN_ALLOW_DEV_URL=""

# Neon PostgreSQL pooled connection string used by the application.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon direct (non-pooled) connection string used for migrations and scripts.
DATABASE_URL_DIRECT="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# 32+ byte secret used to pepper session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Dedicated 32+ character key for encrypting TOTP secrets and peppering
# recovery-code hashes. Recommended in production so AUTH_SECRET rotation does
# not lock out MFA-enabled accounts. When empty, AUTH_SECRET is used.
MFA_ENCRYPTION_KEY=""

# Optional administrator MFA enforcement. Defaults to off. Set to 1 only after
# every administrator has enrolled, otherwise their administrator tools stay
# blocked until they finish setup on the account page.
MFA_REQUIRED_FOR_ADMINS=""

# Idle timeout for sessions in minutes (minimum 5, maximum 10080). Defaults to
# 1440 (24 hours). The absolute session lifetime remains 7 days.
SESSION_IDLE_TIMEOUT_MINUTES="1440"

# ---------------------------------------------------------------------------
# Cloudflare R2 (optional until you are ready to enable uploads)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Separate private bucket for menu scan sources. It must not be publicly readable.
# When empty, scan uploads and previews are disabled.
R2_PRIVATE_BUCKET=""
# Public base URL for the bucket (custom domain or r2.dev URL), no trailing slash.
R2_PUBLIC_BASE_URL=""
# Optional endpoint override; defaults to https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=""

# ---------------------------------------------------------------------------
# Reverse proxy / client IP handling
# ---------------------------------------------------------------------------
# none:   ignore forwarded headers (safest for direct connections)
# vercel: trust Vercel's x-forwarded-for / x-real-ip headers
# proxy:  trust forwarded headers from your own reverse proxy
# Used only for rate limiting; raw IP addresses are never stored.
TRUST_PROXY="none"

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Structured JSON server log threshold: debug, info, warn, or error.
LOG_LEVEL="info"
# Optional fallback when the hosting platform does not expose
# VERCEL_GIT_COMMIT_SHA or GITHUB_SHA. Must be a hexadecimal commit SHA.
BUILD_COMMIT_SHA=""

# ---------------------------------------------------------------------------
# Backups and disaster recovery
# ---------------------------------------------------------------------------
# 32+ character random key used to encrypt backup snapshots with AES-256-GCM.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Store it in a password manager and as a Vercel Production secret. Losing this
# key makes existing backups unrecoverable. Never commit the real key.
BACKUP_ENCRYPTION_KEY=""

# Local output directory for encrypted backups (gitignored). Never store
# unencrypted snapshots on disk.
BACKUP_OUTPUT_DIR="backups"

# Delete backups older than this many days, but always keep the newest N
# copies. Set BACKUP_RETENTION_DAYS=0 to disable pruning entirely.
BACKUP_RETENTION_DAYS="30"
BACKUP_MIN_COPIES="3"

# `npm run db:backup:check` fails when the newest backup is older than this.
BACKUP_MAX_AGE_HOURS="26"

# Real restore only. Point RESTORE_DATABASE_URL at a fresh, migrated database
# or Neon branch. It must differ from every configured development/test URL.
# Both RESTORE_CONFIRM=RESTORE and ALLOW_DESTRUCTIVE_DB_TESTS=1 are required.
RESTORE_DATABASE_URL=""
RESTORE_CONFIRM=""

# ---------------------------------------------------------------------------
# Menu extraction (optional until you are ready to enable scanning)
# Supported provider: "openai" | "disabled"
# ---------------------------------------------------------------------------
EXTRACTION_PROVIDER="disabled"
EXTRACTION_BASE_URL="https://api.openai.com/v1"
EXTRACTION_API_KEY=""
EXTRACTION_MODEL="gpt-4o-mini"
# Maximum pages sent to the provider in one import request.
EXTRACTION_MAX_PAGES="10"
# Per-request timeout in milliseconds.
EXTRACTION_TIMEOUT_MS="90000"

# ---------------------------------------------------------------------------
# Administrative seed (only read by scripts/seed-admin.ts)
# Never commit real credentials. The seed script refuses to run without both.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Set to 1 with RECOVER_ADMIN_CONFIRM=1 to also disable MFA and clear recovery
# codes during sole-administrator recovery. Existing sessions are revoked.
RECOVER_ADMIN_DISABLE_MFA=""

# ---------------------------------------------------------------------------
# Integration tests (dedicated disposable database ONLY)
# Never point these at your development database.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=""
ALLOW_DESTRUCTIVE_DB_TESTS=""
